APP_NAME="Sistema de Horarios"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=change-me-to-a-random-32-byte-string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=horarios
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=horarios_session
SESSION_LIFETIME=480

# La configuracion de Microsoft 365 / Entra ID (Fase 2, SSO) ya NO se
# gestiona por variables de entorno: se administra desde la pantalla
# /admin/ms365 (tabla configuracion_ms365), para poder rotar el client
# secret u otros valores sin editar archivos ni redesplegar.
